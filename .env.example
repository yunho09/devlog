# GitHub
GITHUB_TOKEN=ghp_your_token_here
GITHUB_USERNAME=your-github-username

# Obsidian
OBSIDIAN_VAULT=/home/yunho/Documents/Obsidian
OBSIDIAN_DEVLOG_DIR=DevLog
DEVLOG_SYNC_DAYS=7

# Optional Gemini summarization. Gemini has a free tier in Google AI Studio.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Optional OpenAI fallback. Leave both AI keys empty to use free commit-message notes.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
